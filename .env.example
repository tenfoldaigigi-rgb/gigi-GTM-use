# Slack Bot Tokens (from https://api.slack.com/apps)
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-level-token
SLACK_SIGNING_SECRET=your-signing-secret

# Anthropic API Key (from https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-your-api-key

# Optional: customize the model
CLAUDE_MODEL=claude-sonnet-4-6

# Google Drive Integration
# Folder ID from the Drive URL: https://drive.google.com/drive/folders/<THIS_PART>
GOOGLE_DRIVE_FOLDER_ID=1j-3uWjNXmhRc6tIaS9QH-eQQ73QQCMDB

# Service account credentials — provide ONE of these:
# Option A: Path to the JSON key file (default: ./service-account.json)
GOOGLE_SERVICE_ACCOUNT_FILE=./service-account.json
# Option B: JSON string (useful for cloud deployments)
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
